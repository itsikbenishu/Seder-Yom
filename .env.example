# Repo-root env - read by `docker compose` for the client image's build args.
# Vite inlines VITE_* at BUILD time, so the client Dockerfile needs them here as
# build args (see DEPLOY.md §1.3). This is the public Firebase web-app config
# (not secret); it should be the same Firebase project as worker/.env's
# FIREBASE_SERVICE_ACCOUNT_JSON. Omit any value and push registration silently no-ops.
#
# Copy to `.env` (gitignored) and fill in:
#   Firebase Console > Project settings > General > Your apps > Web app > SDK setup

VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
# Cloud Messaging > Web configuration > "Web Push certificates" key pair
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key

# Optional - the client defaults this to /api/v1 (nginx proxies it to the server).
# VITE_API_URL=/api/v1
