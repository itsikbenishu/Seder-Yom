VITE_API_URL=http://localhost:3000/api/v1

# Firebase web app config (Firebase Console > Project Settings > General > Your apps).
# Public values, not secrets. Must be the same Firebase project as the worker's
# service account. VAPID key: Project Settings > Cloud Messaging > Web Push certificates.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
