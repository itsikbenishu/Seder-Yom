# Supabase Postgres connection (pooler - Supavisor transaction mode, port 6543)
POSTGRES_HOST=aws-0-ap-southeast-1.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_USER=postgres.[PROJECT-REF]
POSTGRES_PASSWORD=[YOUR-PASSWORD]
POSTGRES_DB=postgres

# RabbitMQ (docker-compose service)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

PORT=3000

# Supabase Auth (passwordless email OTP)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]

# Supabase Storage (server-side uploads for /files/upload - bucket must exist)
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=event-files

NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Google Calendar OAuth (read-only sync - Google Cloud Console > APIs & Services > Credentials)
GOOGLE_OAUTH_CLIENT_ID=[YOUR-CLIENT-ID].apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=[YOUR-CLIENT-SECRET]
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/gcal/callback

# Optional - "true" only when there's no separate worker deployment (e.g. Render); also requires worker/.env.example's vars.
RUN_WORKER_INLINE=false

# Optional - "none" only when client and server are on different sites (e.g. Vercel + Render); otherwise the auth cookie won't come back on cross-site requests.
AUTH_COOKIE_SAME_SITE=lax
