# Supabase Postgres connection (pooler — Supavisor transaction mode, port 6543)
POSTGRES_HOST=aws-0-ap-southeast-1.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_USER=postgres.[PROJECT-REF]
POSTGRES_PASSWORD=[YOUR-PASSWORD]
POSTGRES_DB=postgres

# RabbitMQ (docker-compose service) — must match server/.env's value
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Supabase Storage (orphan file cleanup — bucket must exist)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=event-files

# Firebase Admin SDK service-account, as a single JSON string (Firebase Console >
# Project Settings > Service Accounts > Generate new private key, then minify to one line)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

NODE_ENV=development
